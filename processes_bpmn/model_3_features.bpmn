    <bpmn:sequenceFlow id="Flow_5" sourceRef="Train_Model_C6" targetRef="Evaluate_and_Test_Model_C6_9" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Evaluate_and_Test_Model_C6_9" targetRef="EndEvent_1" />
  </bpmn:process>
