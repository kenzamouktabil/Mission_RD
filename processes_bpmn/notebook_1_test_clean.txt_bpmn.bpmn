    <bpmn:sequenceFlow id="Flow_6" sourceRef="Register_Model_C9" targetRef="Serve_Inference_C11" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Serve_Inference_C11" targetRef="Evaluate_and_Test_Model_C12" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Evaluate_and_Test_Model_C12" targetRef="Evaluate_and_Test_Model_C17" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Evaluate_and_Test_Model_C17" targetRef="EndEvent_1" />
