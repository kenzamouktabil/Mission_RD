<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1" name="Data Engineer">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ingest_Data_C3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ingest_Data_C5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Preprocess_Data_C5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Engineer_Features_C6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Model Engineer">
        <bpmn:flowNodeRef>Register_Model_C9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Evaluate_and_Test_Model_C12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Evaluate_and_Test_Model_C17</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Ops Engineer">
        <bpmn:flowNodeRef>Serve_Inference_C11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" />
    <bpmn:endEvent id="EndEvent_1" />
    <bpmn:task id="Ingest_Data_C3" name="Ingest Data" />
